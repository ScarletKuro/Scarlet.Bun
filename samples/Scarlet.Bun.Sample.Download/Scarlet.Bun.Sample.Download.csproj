<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    
    <!-- Enable Bun runtime download mode -->
    <BunRuntimeDownload>true</BunRuntimeDownload>
    <BunVersionDownload>1.3.12</BunVersionDownload>
    <BunRuntimeDirectory>$(MSBuildProjectDirectory)/runtimes</BunRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include source assets for copying -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Import the Bun targets from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Bun.MSBuild\Scarlet.Bun.MSBuild.targets" />

  <ItemGroup>
    <BunInstallInputs Include="package.json" />
    <BunInstallInputs Include="bun.lock" Condition="Exists('$(MSBuildProjectDirectory)\bun.lock')" />
    <BunBuildInputs Include="build.mjs;assets\scripts\**\*.js;assets\styles\**\*.scss" />
    <BunBuildOutputs Include="wwwroot\js\bundle.min.js;wwwroot\css\style.min.css" />

    <BunBeforeStaticWebAssets Include="install">
      <Arguments>--frozen-lockfile</Arguments>
      <TimeoutMilliseconds>60000</TimeoutMilliseconds>
      <Inputs>@(BunInstallInputs)</Inputs>
      <Outputs>node_modules</Outputs>
    </BunBeforeStaticWebAssets>
    <BunBeforeStaticWebAssets Include="run">
      <Arguments>build.mjs</Arguments>
      <TimeoutMilliseconds>60000</TimeoutMilliseconds>
      <Inputs>@(BunBuildInputs)</Inputs>
      <Outputs>@(BunBuildOutputs)</Outputs>
    </BunBeforeStaticWebAssets>
  </ItemGroup>

  <!-- Verify output files exist after build -->
  <Target Name="VerifyBunOutput" AfterTargets="RunBunBeforeStaticWebAssets">
    <Error Text="JavaScript bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\js\bundle.min.js')" />
    <Error Text="CSS bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\style.min.css')" />
    <Message Text="✓ Bun build completed successfully!" Importance="high" />
  </Target>

</Project>
