<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    
    <!-- Enable Bun runtime download mode -->
    <BunRuntimeDownload>true</BunRuntimeDownload>
    <BunVersionDownload>1.3.6</BunVersionDownload>
    <BunRuntimeDirectory>$(MSBuildProjectDirectory)/runtimes</BunRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include source assets for copying -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Import the BunRunTask from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Bun.MSBuild\Scarlet.Bun.MSBuild.targets" />

  <PropertyGroup>
      <!-- Enable Bun runtime download mode -->
      <BunRuntimeDownload>true</BunRuntimeDownload>
      <BunVersionDownload>1.3.6</BunVersionDownload>
      <BunRuntimeDirectory>$(MSBuildProjectDirectory)/runtimes</BunRuntimeDirectory>
  </PropertyGroup>

  <!-- Install Bun dependencies before build (using downloaded runtime) -->
  <Target Name="BunInstall"
          BeforeTargets="PreBuildEvent"
          DependsOnTargets="ResolveProjectReferences">
      <Message Text="Installing dependencies with Bun (download mode)..." Importance="high" />
      <MSBuild Projects="$(MSBuildProjectFullPath)"
               Targets="Bun"
               Properties="BunCommand=install;WorkingDirectory=$(MSBuildProjectDirectory);BunTimeoutMilliseconds=60000" />
  </Target>

  <!-- Build assets using Bun (using downloaded runtime) -->
  <Target Name="BunBuildAssets"
          AfterTargets="BunInstall"
          BeforeTargets="Build"
          DependsOnTargets="ResolveProjectReferences">
      <Message Text="Building assets with Bun (download mode)..." Importance="high" />
      <MSBuild Projects="$(MSBuildProjectFullPath)"
               Targets="Bun"
               Properties="BunCommand=run;BunArguments=build.mjs;WorkingDirectory=$(MSBuildProjectDirectory);BunTimeoutMilliseconds=60000" />
  </Target>

  <!-- Verify output files exist after build -->
  <Target Name="VerifyBunOutput" AfterTargets="BunBuildAssets">
    <Error Text="JavaScript bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\js\bundle.min.js')" />
    <Error Text="CSS bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\style.min.css')" />
    <Message Text="✓ Bun build completed successfully!" Importance="high" />
  </Target>

</Project>
