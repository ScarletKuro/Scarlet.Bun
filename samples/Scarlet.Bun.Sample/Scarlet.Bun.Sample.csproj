<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include source assets for copying -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Import the BunRunTask from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Bun.MSBuild\Scarlet.Bun.MSBuild.targets" />
  
  <!-- Install Bun dependencies before build -->
  <Target Name="BunInstall" 
          BeforeTargets="PreBuildEvent" 
          DependsOnTargets="ResolveProjectReferences">
    <Message Text="Installing dependencies with Bun..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Bun"
             Properties="BunCommand=install;BunArguments=--frozen-lockfile;BunWorkingDirectory=$(MSBuildProjectDirectory);BunTimeoutMilliseconds=60000" />
  </Target>

  <!-- Build assets using Bun -->
  <Target Name="BunBuildAssets" 
          AfterTargets="BunInstall" 
          BeforeTargets="Build" 
          DependsOnTargets="ResolveProjectReferences">
    <Message Text="Building assets with Bun..." Importance="high" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Bun"
             Properties="BunCommand=run;BunArguments=build.mjs;BunWorkingDirectory=$(MSBuildProjectDirectory);BunTimeoutMilliseconds=60000" />
  </Target>

  <!-- Verify output files exist after build -->
  <Target Name="VerifyBunOutput" AfterTargets="BunBuildAssets">
    <Error Text="JavaScript bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\js\bundle.min.js')" />
    <Error Text="CSS bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\style.min.css')" />
    <Message Text="✓ Bun build completed successfully!" Importance="high" />
  </Target>

</Project>
