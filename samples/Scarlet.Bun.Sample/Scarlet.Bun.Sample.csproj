<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include source assets for copying -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Let `dotnet watch` rebuild (and re-run the Bun targets below) when JS/SCSS sources change -->
  <ItemGroup>
    <Watch Include="assets\**\*.js;assets\**\*.scss" Exclude="node_modules\**" />
  </ItemGroup>

  <!-- Import the Bun targets from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Bun.MSBuild\Scarlet.Bun.MSBuild.targets" />

  <ItemGroup>
    <BunBeforeStaticWebAssets Include="install">
      <Arguments>--frozen-lockfile</Arguments>
      <TimeoutMilliseconds>60000</TimeoutMilliseconds>
    </BunBeforeStaticWebAssets>
    <BunBeforeStaticWebAssets Include="run">
      <Arguments>build.mjs</Arguments>
      <TimeoutMilliseconds>60000</TimeoutMilliseconds>
    </BunBeforeStaticWebAssets>
  </ItemGroup>

  <!-- Verify output files exist after build -->
  <Target Name="VerifyBunOutput" AfterTargets="_RunBunBeforeStaticWebAssets">
    <Error Text="JavaScript bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\js\bundle.min.js')" />
    <Error Text="CSS bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\style.min.css')" />
    <Message Text="✓ Bun build completed successfully!" Importance="high" />
  </Target>

</Project>
