<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    A plain ProjectReference, as an app in the same repository would have. Building this app reaches the
    RCL's net10.0 inner build directly and never the RCL's outer build.
  -->
  <ItemGroup>
    <ProjectReference Include="../TestRclMultiTfm/TestRclMultiTfm.csproj" />
  </ItemGroup>

</Project>
