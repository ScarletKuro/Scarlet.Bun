<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scarlet.Bun.MSBuild" Version="{{PACKAGE_VERSION}}">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="{{RUNTIME_PACKAGE}}" Version="{{RUNTIME_VERSION}}">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="build.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Inputs and Outputs reach the task as plain strings, so a glob has to be expanded before it gets there -
      hence the item groups. Written inline, assets\scripts\**\*.js would arrive as a literal path matching
      nothing, the task would decline to stamp, and the step would simply never skip. bun.lock is an input
      because build.mjs runs terser and sass out of node_modules: a dependency bump changes the bundles even
      though no .js or .scss did.
    -->
    <BunBuildInputs Include="build.mjs;assets\scripts\**\*.js;assets\styles\**\*.scss" />
    <BunBuildInputs Include="bun.lock" Condition="Exists('$(MSBuildProjectDirectory)/bun.lock')" />
    <BunBuildOutputs Include="wwwroot\js\bundle.min.js;wwwroot\css\style.min.css" />

    <BunBeforeStaticWebAssets Include="install">
      <Arguments>--frozen-lockfile</Arguments>
    </BunBeforeStaticWebAssets>
    <BunBeforeStaticWebAssets Include="run">
      <Arguments>build.mjs</Arguments>
      <Inputs>@(BunBuildInputs)</Inputs>
      <Outputs>@(BunBuildOutputs)</Outputs>
    </BunBeforeStaticWebAssets>
  </ItemGroup>

  <!--
    The pattern libraries like MudBlazor use: a tool generated these, so a clean removes them and the tool
    produces them again. Combined with multi-targeting - where the stamp outlives the clean, because the
    outer build has no CoreBuild and never runs the incremental clean - this makes the Outputs existence
    check the only thing between a clean and a package permanently missing its assets.
  -->
  <Target Name="CleanGeneratedFiles" BeforeTargets="Clean">
    <Delete Files="wwwroot\js\bundle.min.js;wwwroot\css\style.min.css" />
  </Target>

  <!--
    Fires on every build here, including the ones where the step is skipped - and has to pass on those too,
    because a skip is only correct while the bundles it declined to rebuild are still on disk.
  -->
  <Target Name="VerifyBunOutput" AfterTargets="RunBunBeforeStaticWebAssets"
          Condition="'$(TargetFrameworks)' == '' OR '$(TargetFramework)' == ''">
    <Error Text="JavaScript bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/js/bundle.min.js')" />
    <Error Text="CSS bundle was not created!" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/css/style.min.css')" />
  </Target>
</Project>
