<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>Scarlet.Bun.MSBuild</PackageId>
    <DevelopmentDependency>True</DevelopmentDependency>
    <IsPackable>true</IsPackable>
	<BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
  </PropertyGroup>
  
  <PropertyGroup>
    <Authors>ScarletKuro</Authors>
    <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.Bun</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>MSBuild task for integrating Bun (a fast JavaScript runtime) into .NET build processes. Downloads Bun runtimes on-demand for all supported platforms (Windows, Linux, macOS - x64 and ARM64).</Description>
    <PackageTags>bun;msbuild;javascript;build;bundler;minifier;sass;scss;typescript</PackageTags>
  </PropertyGroup>
  
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
	<!-- pack the build props and targets -->
	<None Include="build\**\*">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
    
    <!-- pack the README -->
    <None Include="..\..\README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference all runtime packages as ProjectReferences during build, but they will be separate NuGet packages -->
    <!-- ReferenceOutputAssembly="false" because we only need the runtime binaries they produce, not their DLLs -->
    <ProjectReference Include="..\Scarlet.Bun.Runtime.windows-x64-baseline\Scarlet.Bun.Runtime.windows-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-x64-baseline\Scarlet.Bun.Runtime.linux-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-aarch64\Scarlet.Bun.Runtime.linux-aarch64.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.darwin-x64-baseline\Scarlet.Bun.Runtime.darwin-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.darwin-aarch64\Scarlet.Bun.Runtime.darwin-aarch64.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy runtime binaries from referenced projects to our output directory -->
  <Target Name="CopyRuntimeBinaries" AfterTargets="Build">
    <ItemGroup>
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.windows-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-aarch64\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.darwin-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.darwin-aarch64\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeFiles)" 
          DestinationFolder="$(OutputPath)..\..\runtimes\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
  </Target>

</Project>
