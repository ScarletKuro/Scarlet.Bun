<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata -->
    <PackageId>Scarlet.Bun.MSBuild</PackageId>
    <Title>Scarlet.Bun.MSBuild - Run Bun in your .NET build</Title>
    <Authors>ScarletKuro</Authors>
    <Description>Run Bun, the fast all-in-one JavaScript runtime and bundler, from your .NET build. Bundle and minify JavaScript and TypeScript, compile Sass/SCSS, and install npm dependencies during dotnet build on Windows, Linux and macOS (x64 and ARM64) - no Node.js required. Works with ASP.NET Core, Blazor and Razor Class Library static web assets. Supply the Bun binary with a platform-specific Scarlet.Bun.Runtime package, or let the build download it on demand.</Description>
    <PackageTags>bun;bunjs;msbuild;dotnet;javascript;typescript;bundler;bundling;minifier;sass;scss;node;npm;blazor;razor;aspnetcore;frontend;staticwebassets</PackageTags>
    <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.Bun</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
	
    <!-- Packaging behavior -->
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>True</DevelopmentDependency>
    <Deterministic>true</Deterministic>
    <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- The assembly is packed under tools/netstandard2.0/ (see BuildOutputTargetFolder above), not
         lib/netstandard2.0/, so NuGet can't see it there and warns that netstandard2.0 has no lib/ref
         assets - a false positive for this MSBuild-task packaging pattern. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
	
    <!-- Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	
    <!-- CI -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Pack the build props and targets files.
    These are what make your package an MSBuild task package.
    They define the tasks and targets consumers can use. -->
	<None Include="build\**\*">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
    <None Include="buildMultiTargeting\**\*">
      <Pack>true</Pack>
      <PackagePath>buildMultiTargeting\</PackagePath>
    </None>

    <None Include="README.md">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </None>
    
    <!-- pack the icon -->
    <None Include="..\..\icon.png">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.0.2" PrivateAssets="all" />
    <PackageReference Include="System.IO.Abstractions" Version="22.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared implementation, also used by Scarlet.Bun.Cli. PrivateAssets keeps its own package
         references from leaking into this package's dependency list; the assembly itself is packed below. -->
    <ProjectReference Include="..\Scarlet.Bun.Core\Scarlet.Bun.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack copied DLLs (We get them from CopyLocalLockFileAssemblies) -->
  <ItemGroup>
    <!-- The task will not load without this: UsingTask points at tools/netstandard2.0/Scarlet.Bun.MSBuild.dll,
         which now depends on Scarlet.Bun.Core.dll sitting next to it. -->
    <None Include="$(OutputPath)\netstandard2.0\Scarlet.Bun.Core.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="$(OutputPath)\netstandard2.0\System.IO.Abstractions.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="$(OutputPath)\netstandard2.0\TestableIO.System.IO.Abstractions.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="$(OutputPath)\netstandard2.0\TestableIO.System.IO.Abstractions.Wrappers.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="$(OutputPath)\netstandard2.0\Testably.Abstractions.FileSystem.Interface.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scarlet.Bun.MSBuild.Tests" />
    <InternalsVisibleTo Include="Scarlet.Bun.MSBuild.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference all runtime packages as ProjectReferences during build, but they will be separate NuGet packages -->
    <!-- ReferenceOutputAssembly="false" because we only need the runtime binaries they produce, not their DLLs -->
    <ProjectReference Include="..\Scarlet.Bun.Runtime.windows-x64-baseline\Scarlet.Bun.Runtime.windows-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.windows-aarch64\Scarlet.Bun.Runtime.windows-aarch64.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-x64-baseline\Scarlet.Bun.Runtime.linux-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-aarch64\Scarlet.Bun.Runtime.linux-aarch64.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-x64-musl-baseline\Scarlet.Bun.Runtime.linux-x64-musl-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.linux-aarch64-musl\Scarlet.Bun.Runtime.linux-aarch64-musl.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.darwin-x64-baseline\Scarlet.Bun.Runtime.darwin-x64-baseline.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Scarlet.Bun.Runtime.darwin-aarch64\Scarlet.Bun.Runtime.darwin-aarch64.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy runtime binaries from referenced projects to our output directory -->
  <Target Name="CopyRuntimeBinaries" AfterTargets="Build">
    <ItemGroup>
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.windows-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.windows-aarch64\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-aarch64\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-x64-musl-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.linux-aarch64-musl\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.darwin-x64-baseline\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
      <RuntimeFiles Include="..\Scarlet.Bun.Runtime.darwin-aarch64\bin\$(Configuration)\netstandard2.0\runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(OutputPath)..\..\runtimes\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
