<Project>
  <!-- Load the Bun MSBuild task -->
  <UsingTask TaskName="Scarlet.Bun.MSBuild.BunRunTask" AssemblyFile="$(MSBuildThisFileDirectory)../tools/netstandard2.0/Scarlet.Bun.MSBuild.dll" />

  <!--
    Expose a reusable MSBuild task wrapper that automatically passes runtime properties.

    Users can call this using the MSBuild Task syntax with properties:

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Bun"
             Properties="BunCommand=install;BunWorkingDirectory=$(MSBuildProjectDirectory)" />

    Or define a target that sets properties and calls Bun:

    <PropertyGroup>
      <BunCommand>install</BunCommand>
      <BunWorkingDirectory>$(MSBuildProjectDirectory)</BunWorkingDirectory>
    </PropertyGroup>
    <Target Name="BunInstall" BeforeTargets="Build">
      <CallTarget Targets="Bun" />
    </Target>

    Supported properties:
    - BunCommand (required) - The Bun command to execute
    - BunArguments (optional) - Command arguments
    - BunWorkingDirectory (optional) - Working directory
    - BunTimeoutMilliseconds (optional) - Timeout in milliseconds
    - BunContinueOnError (optional) - Continue on error
    - BunRuntimeDirectory (optional) - Override runtime directory; wins over @(BunRuntimePack)
    - BunRuntimeDownload (optional) - Download runtime from GitHub instead of using embedded
    - BunVersionDownload (optional) - Specific version to download (defaults to latest)
    - BunDownloadMutexTimeoutSeconds (optional) - How long to wait for a concurrent download

    How the runtime is found:
    Each referenced Scarlet.Bun.Runtime.* package contributes a @(BunRuntimePack) item from its
    build/*.props, and the task picks the one matching the build host. Because the contract is an item,
    a new runtime identifier needs no change to this package. To point at a Bun you built yourself:

    <ItemGroup>
      <BunRuntimePack Include="MyCompany.Bun.linux-x64-musl">
        <Rid>linux-x64</Rid>
        <RuntimesPath>$(MSBuildProjectDirectory)/bun/runtimes</RuntimesPath>
        <Priority>100</Priority>
      </BunRuntimePack>
    </ItemGroup>

    RuntimesPath must contain <rid>/native/bun (bun.exe on Windows). When several packs serve the same
    Rid the highest Priority wins; ties are broken by pack id so the result never depends on restore order.

    Note that runtime packages are marked as development dependencies, so their props apply to the
    project that references them directly - they do not flow to projects that reference that project.

    The BunRuntime_<rid> properties below are the previous contract. They are still passed so that
    runtime packages published before @(BunRuntimePack) existed keep working.
  -->
  <Target Name="Bun">
    <Error Text="BunCommand property is required" Condition="'$(BunCommand)' == ''" />

    <BunRunTask Command="$(BunCommand)"
                Arguments="$(BunArguments)"
                WorkingDirectory="$(BunWorkingDirectory)"
                TimeoutMilliseconds="$(BunTimeoutMilliseconds)"
                ContinueOnError="$(BunContinueOnError)"
                RuntimeDirectory="$(BunRuntimeDirectory)"
                BunRuntimeDownload="$(BunRuntimeDownload)"
                BunVersionDownload="$(BunVersionDownload)"
                DownloadMutexTimeoutSeconds="$(BunDownloadMutexTimeoutSeconds)"
                RuntimePacks="@(BunRuntimePack)"
                BunRuntime_win_x64="$(BunRuntime_win_x64)"
                BunRuntime_win_arm64="$(BunRuntime_win_arm64)"
                BunRuntime_linux_x64="$(BunRuntime_linux_x64)"
                BunRuntime_linux_arm64="$(BunRuntime_linux_arm64)"
                BunRuntime_osx_x64="$(BunRuntime_osx_x64)"
                BunRuntime_osx_arm64="$(BunRuntime_osx_arm64)">
      <Output TaskParameter="ExitCode" PropertyName="BunExitCode" />
      <Output TaskParameter="StandardOutput" PropertyName="BunStandardOutput" />
      <Output TaskParameter="StandardError" PropertyName="BunStandardError" />
    </BunRunTask>
  </Target>

  <!--
    Runs Bun steps before the Razor/static web assets SDK discovers wwwroot files.

    Example:

    <ItemGroup>
      <BunBeforeStaticWebAssets Include="run">
        <Arguments>build.mjs</Arguments>
      </BunBeforeStaticWebAssets>
    </ItemGroup>

    Include is the Bun command. Optional metadata: Arguments, WorkingDirectory,
    TimeoutMilliseconds, ContinueOnError.

    Only the project's own wwwroot is picked back up. That is not a shortcut - the SDK hardcodes it
    too (ContentRoot="$(MSBuildProjectDirectory)\wwwroot\" and RelativePathPattern="wwwroot/**" in
    Microsoft.NET.Sdk.StaticWebAssets.targets), so a step whose output lands anywhere else can never
    become a static web asset. Point the Bun script's output at wwwroot even when WorkingDirectory
    sends the step somewhere else.

    Why this runs before discovery rather than contributing assets directly:
    the SDK splits asset resolution into stages, and its own comments describe ResolveCoreStaticWebAssets
    as the one for assets that "exist on disk and are part of the project", and ResolveStaticWebAssetsInputs
    as the one for assets "generated by the build process, like scoped CSS bundles" - the latter has public
    hooks ($(ResolveStaticWebAssetsInputsDependsOn) and friends) and expects hand-authored @(StaticWebAsset)
    items carrying SourceId, SourceType, ContentRoot, BasePath, RelativePath, AssetKind, AssetMode,
    AssetRole, Fingerprint and Integrity. Running Bun early puts the files on disk before discovery, so they
    qualify for the first stage and the SDK derives all of that itself, fingerprinting and endpoints
    included. The cost is that the steps must run before ResolveProjectStaticWebAssets, which is why that
    target is named explicitly below: it hooks AssignTargetPaths, which can precede PreBuildEvent.

    NoBuild is in the condition because a BeforeTargets hook still fires when the target it hooks is
    skipped by its own condition, and ResolveProjectStaticWebAssets carries Condition="'$(NoBuild)' != 'true'".
    Without the guard, a no-build pack re-runs every step to produce assets that nothing will then
    discover - it packs from the manifest the earlier build wrote.
  -->
  <Target Name="RunBunBeforeStaticWebAssets"
          BeforeTargets="DispatchToInnerBuilds;ResolveProjectStaticWebAssets;PreBuildEvent"
          Condition="'@(BunBeforeStaticWebAssets)' != '' AND '$(NoBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">
    <ItemGroup>
      <_BunBeforeStaticWebAssetsStep Include="@(BunBeforeStaticWebAssets)">
        <WorkingDirectory Condition="'%(BunBeforeStaticWebAssets.WorkingDirectory)' == ''">$(MSBuildProjectDirectory)</WorkingDirectory>
        <TimeoutMilliseconds Condition="'%(BunBeforeStaticWebAssets.TimeoutMilliseconds)' == ''">$(BunTimeoutMilliseconds)</TimeoutMilliseconds>
        <ContinueOnError Condition="'%(BunBeforeStaticWebAssets.ContinueOnError)' == ''">$(BunContinueOnError)</ContinueOnError>
      </_BunBeforeStaticWebAssetsStep>
    </ItemGroup>

    <BunRunTask Command="%(_BunBeforeStaticWebAssetsStep.Identity)"
                Arguments="%(_BunBeforeStaticWebAssetsStep.Arguments)"
                WorkingDirectory="%(_BunBeforeStaticWebAssetsStep.WorkingDirectory)"
                TimeoutMilliseconds="%(_BunBeforeStaticWebAssetsStep.TimeoutMilliseconds)"
                ContinueOnError="%(_BunBeforeStaticWebAssetsStep.ContinueOnError)"
                RuntimeDirectory="$(BunRuntimeDirectory)"
                BunRuntimeDownload="$(BunRuntimeDownload)"
                BunVersionDownload="$(BunVersionDownload)"
                DownloadMutexTimeoutSeconds="$(BunDownloadMutexTimeoutSeconds)"
                RuntimePacks="@(BunRuntimePack)"
                BunRuntime_win_x64="$(BunRuntime_win_x64)"
                BunRuntime_win_arm64="$(BunRuntime_win_arm64)"
                BunRuntime_linux_x64="$(BunRuntime_linux_x64)"
                BunRuntime_linux_arm64="$(BunRuntime_linux_arm64)"
                BunRuntime_osx_x64="$(BunRuntime_osx_x64)"
                BunRuntime_osx_arm64="$(BunRuntime_osx_arm64)" />

    <!--
      Bun wrote these after MSBuild evaluated the project, so the SDK's own wwwroot glob missed them.
      The path must stay project-relative: the static web assets SDK matches candidates against
      "wwwroot/**", and an absolute path silently falls through to plain content instead.
      Exclude keeps @(Content) free of duplicates on incremental builds, where the glob did already pick
      the files up. DefineStaticWebAssets distincts its own candidates, so this is about not handing other
      consumers of @(Content) the same file twice.
    -->
    <ItemGroup>
      <Content Include="wwwroot\**\*" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
</Project>
