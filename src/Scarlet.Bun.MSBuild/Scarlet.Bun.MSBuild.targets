<Project>
  <!-- Reference the output of the task project, using properties that expand to match the real output. -->
  <PropertyGroup>
    <_BunTaskProjectDir>$(MSBuildThisFileDirectory)</_BunTaskProjectDir>
    <_BunTaskAssembly>$(_BunTaskProjectDir)bin\$(Configuration)\netstandard2.0\Scarlet.Bun.MSBuild.dll</_BunTaskAssembly>
    <!-- Set the runtime directory for development scenarios.
         Conditional so a project can opt into download mode (or point somewhere else) before importing this file. -->
    <BunRuntimeDirectory Condition="'$(BunRuntimeDirectory)' == ''">$(_BunTaskProjectDir)bin\runtimes</BunRuntimeDirectory>
    <BunContinueOnError Condition="'$(BunContinueOnError)' == ''">false</BunContinueOnError>
    <BunCaptureOutput Condition="'$(BunCaptureOutput)' == ''">true</BunCaptureOutput>
  </PropertyGroup>

  <!-- Using TaskHostFactory ensures that the task assembly will not be locked at the end of the build.
       If it's omitted, that can cause build failures in subsequent builds because the task assembly
       can't be written by the next build. -->
  <UsingTask TaskName="Scarlet.Bun.MSBuild.BunRunTask"
             AssemblyFile="$(_BunTaskAssembly)"
             TaskFactory="TaskHostFactory" />

  <ItemGroup>
    <!-- Add a ProjectReference to ensure that the task gets built before it needs to be called. -->
    <ProjectReference Include="$(_BunTaskProjectDir)Scarlet.Bun.MSBuild.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Expose the Bun target wrapper for development scenarios.
    This is the same target that's in build/Scarlet.Bun.MSBuild.targets for NuGet consumption.
  -->
  <Target Name="Bun">
    <Error Text="BunCommand property is required" Condition="'$(BunCommand)' == ''" />

    <PropertyGroup>
      <BunWorkingDirectory Condition="'$(BunWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</BunWorkingDirectory>
      <_BunStampDirectory Condition="'$(BunStampDirectory)' != ''">$(BunStampDirectory)</_BunStampDirectory>
      <_BunStampDirectory Condition="'$(_BunStampDirectory)' == '' AND '$(IntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Scarlet.Bun'))))</_BunStampDirectory>
    </PropertyGroup>

    <BunRunTask Command="$(BunCommand)"
                Arguments="$(BunArguments)"
                WorkingDirectory="$(BunWorkingDirectory)"
                TimeoutMilliseconds="$(BunTimeoutMilliseconds)"
                ContinueOnError="$(BunContinueOnError)"
                CaptureOutput="$(BunCaptureOutput)"
                Inputs="$(BunInputs)"
                Outputs="$(BunOutputs)"
                StampFile="$(BunStampFile)"
                StampDirectory="$(_BunStampDirectory)"
                ProjectDirectory="$(MSBuildProjectDirectory)"
                RuntimeDirectory="$(BunRuntimeDirectory)"
                BunRuntimeDownload="$(BunRuntimeDownload)"
                BunVersionDownload="$(BunVersionDownload)"
                DownloadMutexTimeoutSeconds="$(BunDownloadMutexTimeoutSeconds)"
                RuntimePacks="@(BunRuntimePack)"
                BunRuntime_win_x64="$(BunRuntime_win_x64)"
                BunRuntime_win_arm64="$(BunRuntime_win_arm64)"
                BunRuntime_linux_x64="$(BunRuntime_linux_x64)"
                BunRuntime_linux_arm64="$(BunRuntime_linux_arm64)"
                BunRuntime_osx_x64="$(BunRuntime_osx_x64)"
                BunRuntime_osx_arm64="$(BunRuntime_osx_arm64)">
      <Output TaskParameter="ExitCode" PropertyName="BunExitCode" />
      <Output TaskParameter="StandardOutput" PropertyName="BunStandardOutput" />
      <Output TaskParameter="StandardError" PropertyName="BunStandardError" />
      <Output TaskParameter="StampFilePath" ItemName="FileWrites" Condition="'$(BunInputs)' != '' AND '$(BunOutputs)' != ''" />
    </BunRunTask>
  </Target>

  <!--
    Development copy of the NuGet target that runs Bun steps before the
    Razor/static web assets SDK discovers wwwroot files.

    build/Scarlet.Bun.MSBuild.targets documents the item metadata, why only the project's own wwwroot is
    picked back up, and why the steps run before discovery instead of contributing @(StaticWebAsset)
    items. That rationale is deliberately not duplicated here: BunTargetsTests compares the <Target>
    elements, not the comments around them, so a second copy could drift without failing anything.

    Single-targeted projects only. DependsOnTargets below is what gets the task assembly built before the
    task runs, and ResolveProjectReferences does not exist in a cross-targeting outer build - which is
    exactly where this target runs for a multi-targeted project, so importing this file there fails with
    MSB4057. The packaged copy carries no such dependency and is fine; only this development file is
    affected, and it is never packed (see the csproj: only build\ and buildMultiTargeting\ ship). Every
    sample and integration test that imports this is single-targeted, and multi-targeting is covered
    against the real package by tests/e2e/multi-tfm.
  -->
  <Target Name="RunBunBeforeStaticWebAssets"
          BeforeTargets="DispatchToInnerBuilds;ResolveProjectStaticWebAssets;PreBuildEvent"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(BunBeforeStaticWebAssets)' != '' AND '$(NoBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">
    <PropertyGroup>
      <!--
        Path.Combine returns the second argument unchanged when it is already rooted, so this is correct
        for a relocated BaseIntermediateOutputPath or an artifacts layout as well as the usual obj\<cfg>\<tfm>\.
      -->
      <_BunStampDirectory Condition="'$(BunStampDirectory)' != ''">$(BunStampDirectory)</_BunStampDirectory>
      <_BunStampDirectory Condition="'$(_BunStampDirectory)' == '' AND '$(IntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Scarlet.Bun'))))</_BunStampDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_BunBeforeStaticWebAssetsStep Include="@(BunBeforeStaticWebAssets)">
        <WorkingDirectory Condition="'%(BunBeforeStaticWebAssets.WorkingDirectory)' == ''">$(MSBuildProjectDirectory)</WorkingDirectory>
        <TimeoutMilliseconds Condition="'%(BunBeforeStaticWebAssets.TimeoutMilliseconds)' == ''">$(BunTimeoutMilliseconds)</TimeoutMilliseconds>
        <ContinueOnError Condition="'%(BunBeforeStaticWebAssets.ContinueOnError)' == ''">$(BunContinueOnError)</ContinueOnError>
      </_BunBeforeStaticWebAssetsStep>
    </ItemGroup>

    <BunRunTask Command="%(_BunBeforeStaticWebAssetsStep.Identity)"
                Arguments="%(_BunBeforeStaticWebAssetsStep.Arguments)"
                WorkingDirectory="%(_BunBeforeStaticWebAssetsStep.WorkingDirectory)"
                TimeoutMilliseconds="%(_BunBeforeStaticWebAssetsStep.TimeoutMilliseconds)"
                ContinueOnError="%(_BunBeforeStaticWebAssetsStep.ContinueOnError)"
                CaptureOutput="false"
                Inputs="%(_BunBeforeStaticWebAssetsStep.Inputs)"
                Outputs="%(_BunBeforeStaticWebAssetsStep.Outputs)"
                StampFile="%(_BunBeforeStaticWebAssetsStep.StampFile)"
                StampDirectory="$(_BunStampDirectory)"
                ProjectDirectory="$(MSBuildProjectDirectory)"
                RuntimeDirectory="$(BunRuntimeDirectory)"
                BunRuntimeDownload="$(BunRuntimeDownload)"
                BunVersionDownload="$(BunVersionDownload)"
                DownloadMutexTimeoutSeconds="$(BunDownloadMutexTimeoutSeconds)"
                RuntimePacks="@(BunRuntimePack)"
                BunRuntime_win_x64="$(BunRuntime_win_x64)"
                BunRuntime_win_arm64="$(BunRuntime_win_arm64)"
                BunRuntime_linux_x64="$(BunRuntime_linux_x64)"
                BunRuntime_linux_arm64="$(BunRuntime_linux_arm64)"
                BunRuntime_osx_x64="$(BunRuntime_osx_x64)"
                BunRuntime_osx_arm64="$(BunRuntime_osx_arm64)">
      <Output TaskParameter="StampFilePath" ItemName="FileWrites"
              Condition="'%(_BunBeforeStaticWebAssetsStep.Inputs)' != '' AND '%(_BunBeforeStaticWebAssetsStep.Outputs)' != ''" />
    </BunRunTask>

    <!--
      Bun wrote these after MSBuild evaluated the project, so the SDK's own wwwroot glob missed them.
      The path must stay project-relative: the static web assets SDK matches candidates against
      "wwwroot/**", and an absolute path silently falls through to plain content instead.
      Exclude keeps @(Content) free of duplicates on incremental builds, where the glob did already pick
      the files up. DefineStaticWebAssets distincts its own candidates, so this is about not handing other
      consumers of @(Content) the same file twice.
    -->
    <ItemGroup>
      <Content Include="wwwroot\**\*" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
</Project>
